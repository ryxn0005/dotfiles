#!/bin/sh

wallpaper=$(ls ~/Pictures | wmenu -i -f "JetBrainsMono Nerd Font Bold 16" -l 5 -N "#16161d" -n "#b9bdc5" -S "#b9bdc5" -s "#16161d")

[ -z "$wallpaper" ] && exit

killall swaybg 2>/dev/null
echo "$HOME/Pictures/$wallpaper" >~/.cache/current_wallpaper
swaybg --output '*' --mode fill --image "$HOME/Pictures/$wallpaper" &
